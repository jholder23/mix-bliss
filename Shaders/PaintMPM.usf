// Impasto viscous oil — GPU MLS-MPM port of Source/Impasto/Private/PaintMPM.cpp
// Quadratic B-splines, APIC C, Tait EOS, Batty–Bridson Jacobi viscosity.
// Enable by wiring FGlobalShader dispatches in a later chapter. CPU path is live.
// Mapped as /Impasto/PaintMPM.usf from FImpastoModule.

#ifndef THREADGROUP
#define THREADGROUP 64
#endif

struct FParticle
{
	float2 Pos;
	float2 Vel;
	float4 C; // c00,c01,c10,c11
	float Mass;
	float3 Color;
};

struct FGridCell
{
	float Mass;
	float2 Momentum;
	float2 Vel;
};

RWStructuredBuffer<FParticle> Particles;
RWStructuredBuffer<FGridCell> Grid;
uint ParticleCount;
int GridNodes;
float Dt;
float RestDensity;
float Stiffness;
float Viscosity;
float Damping;
float4 Knife; // xy pos, zw delta
float2 KnifeSize; // length, width
int KnifeActive;

float3 QWeights(float Fx)
{
	const float D = Fx - 1.0;
	const float E = Fx - 0.5;
	return float3(
		0.5 * (1.5 - Fx) * (1.5 - Fx),
		0.75 - D * D,
		0.5 * E * E);
}

[numthreads(THREADGROUP, 1, 1)]
void ClearGridCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint N = GridNodes * GridNodes;
	if (Tid.x >= N) return;
	Grid[Tid.x].Mass = 0;
	Grid[Tid.x].Momentum = 0;
	Grid[Tid.x].Vel = 0;
}

[numthreads(THREADGROUP, 1, 1)]
void P2GMassCS(uint3 Tid : SV_DispatchThreadID)
{
	if (Tid.x >= ParticleCount) return;
	const FParticle P = Particles[Tid.x];
	const int2 B = int2(floor(P.Pos - 0.5));
	const float2 F = P.Pos - float2(B);
	const float3 Wx = QWeights(F.x);
	const float3 Wy = QWeights(F.y);
	[unroll]
	for (int i = 0; i < 3; ++i)
	{
		const int Gi = B.x + i;
		if (Gi < 0 || Gi >= GridNodes) continue;
		[unroll]
		for (int j = 0; j < 3; ++j)
		{
			const int Gj = B.y + j;
			if (Gj < 0 || Gj >= GridNodes) continue;
			const uint Idx = Gi * GridNodes + Gj;
			InterlockedAdd(Grid[Idx].Mass, Wx[i] * Wy[j] * P.Mass); // Mass is float — use atomic via asuint in a later pass
		}
	}
}

[numthreads(THREADGROUP, 1, 1)]
void GridVelocityCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint N = GridNodes * GridNodes;
	if (Tid.x >= N) return;
	if (Grid[Tid.x].Mass > 1e-5)
	{
		Grid[Tid.x].Vel = Grid[Tid.x].Momentum / Grid[Tid.x].Mass;
	}
}
